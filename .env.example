# DropX Backend — Environment Variables
# Copy this file to .env and fill in the real values.
# Never commit .env to version control.

# Django core
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Database (leave as-is for local SQLite dev; set DB_* vars for PostgreSQL in prod)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=dropx
# DB_USER=dropx
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Redis / Channels
USE_REDIS=false
REDIS_URL=redis://127.0.0.1:6379/0

# CORS (prod only — set CORS_ALLOWED_ORIGINS in .env.prod)
# CORS_ALLOWED_ORIGINS=https://app.dropx.pk,https://admin.dropx.pk
